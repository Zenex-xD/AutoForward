# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Telegram API ID and API Hash from https://my.telegram.org
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Database Configuration
# MongoDB connection URI (e.g. MongoDB Atlas: mongodb+srv://user:pass@cluster.xxx.mongodb.net/?retryWrites=true&w=majority)
MONGO_URI=
MONGO_DB_NAME=telegram_forwarder

# SQLite Database Path (Fallback if MONGO_URI is not provided)
DATABASE_PATH=data/bot_database.db
